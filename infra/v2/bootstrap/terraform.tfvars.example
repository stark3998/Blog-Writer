# Copy to terraform.tfvars (gitignored) and fill in. This repository is public:
# never commit real subscription/tenant/object IDs, email addresses or names.

# Leave unset and export ARM_SUBSCRIPTION_ID instead, or set it here locally.
# subscription_id = "00000000-0000-0000-0000-000000000000"

location            = "eastus"
resource_group_name = "rg-blog-writer-v2-tfstate"

# Optional: pin the state account name instead of the derived "stbw2tf<hash>".
# storage_account_name = "stbw2tfexample"

# Lab-required resource group tags (exact names: Purpose, Owner, Expiry Date).
tag_purpose     = "<purpose>"
tag_owner       = "<owner-alias>"
tag_expiry_date = "2027-06-30"

# After the main root exists, grant its CI identity access to the state
# container (value: output identity_principal_ids["ci_infra"] of infra/v2),
# then re-run terraform apply here.
# state_contributor_principal_ids = {
#   ci_infra = "00000000-0000-0000-0000-000000000000"
# }
