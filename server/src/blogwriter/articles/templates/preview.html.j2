<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Preview: {{ title }}</title>
<style>
:root { color-scheme: light; }
* { box-sizing: border-box; }
body { margin: 0; background: #fbfaf7; color: #1c1b19; font: 18px/1.65 ui-serif, Georgia, "Times New Roman", serif; }
.preview-banner { margin: 0; padding: 8px 16px; background: #0e2a24; color: #f4f1ea; font: 13px/1.4 ui-sans-serif, system-ui, sans-serif; text-align: center; }
.post { max-width: 720px; margin: 0 auto; padding: 40px 20px 80px; }
.post-header { margin-bottom: 32px; }
.eyebrow { margin: 0 0 8px; color: #5c5a55; font: 600 13px/1.4 ui-sans-serif, system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; }
h1 { margin: 0 0 12px; font-size: 2.2rem; line-height: 1.2; }
.excerpt { margin: 0 0 12px; color: #3d3b37; font-size: 1.15rem; }
.byline { margin: 0; color: #5c5a55; font: 14px/1.4 ui-sans-serif, system-ui, sans-serif; }
.hero { margin: 24px 0 0; }
.hero img, .post-body img { display: block; max-width: 100%; height: auto; }
.toc { margin: 0 0 32px; padding: 16px 20px; border-left: 3px solid #0e2a24; background: #f2efe8; font: 15px/1.5 ui-sans-serif, system-ui, sans-serif; }
.toc-title { margin: 0 0 6px; font-weight: 600; }
.toc ol { margin: 0; padding-left: 20px; }
.toc .toc-l3 { margin-left: 16px; list-style: circle; }
.post-body h2 { margin: 2em 0 .6em; font-size: 1.5rem; line-height: 1.3; }
.post-body h3 { margin: 1.6em 0 .5em; font-size: 1.2rem; }
.post-body h4 { margin: 1.4em 0 .4em; font-size: 1.05rem; }
.post-body a { color: #0b5d4f; }
.post-body blockquote { margin: 1.2em 0; padding: 0 0 0 16px; border-left: 3px solid #c9c4b8; color: #3d3b37; }
.post-body code { font: .88em/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
.post-body pre { overflow-x: auto; padding: 14px 16px; border-radius: 6px; }
.post-body table { width: 100%; border-collapse: collapse; font-size: .92em; }
.post-body th, .post-body td { padding: 6px 10px; border-bottom: 1px solid #ddd8cd; }
.post-body figure.mermaid { margin: 1.6em 0; }
.post-body pre.mermaid-source { background: #f2efe8; }
.callout { margin: 1.4em 0; padding: 12px 16px; border-radius: 6px; border-left: 4px solid; }
.callout-note { background: #eef3f8; border-color: #3a6ea5; }
.callout-tip { background: #edf6f0; border-color: #2e7d4f; }
.callout-warning { background: #fbf3e6; border-color: #b26a00; }
.contains-task-list { list-style: none; padding-left: 4px; }
.footnotes { margin-top: 3em; font-size: .9em; color: #3d3b37; }
.missing-image { display: block; margin: 1em 0; padding: 18px; border: 1px dashed #b9b3a6; color: #5c5a55; font: 15px/1.4 ui-sans-serif, system-ui, sans-serif; text-align: center; }
.preview-error { color: #8a1c1c; }
.disclaimer { margin-top: 3em; padding-top: 1em; border-top: 1px solid #ddd8cd; color: #5c5a55; font: 14px/1.5 ui-sans-serif, system-ui, sans-serif; }
{{ code_css }}
</style>
</head>
<body>
<p class="preview-banner">{{ banner }}</p>
<article class="post">
<header class="post-header">
{% if eyebrow %}
<p class="eyebrow">{{ eyebrow }}</p>
{% endif %}
<h1>{{ title }}</h1>
{% if excerpt %}
<p class="excerpt">{{ excerpt }}</p>
{% endif %}
<p class="byline">{{ byline }}</p>
{% if hero %}
<figure class="hero">{{ hero }}</figure>
{% endif %}
</header>
{% if toc %}
<nav class="toc" aria-label="Contents">
<p class="toc-title">Contents</p>
<ol>
{% for entry in toc %}
<li class="toc-l{{ entry.level }}"><a href="#{{ entry.id }}">{{ entry.text }}</a></li>
{% endfor %}
</ol>
</nav>
{% endif %}
<div class="post-body">
{{ body }}
</div>
{% if disclaimer %}
<p class="disclaimer">{{ disclaimer }}</p>
{% endif %}
</article>
</body>
</html>
