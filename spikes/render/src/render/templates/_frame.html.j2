{#- Shared slide chrome: progress rail, content box, footer. Every text box that can overflow carries
    data-fit so the renderer can refuse clipped output. -#}
{% macro frame(view, author_in_footer=true) -%}
<section class="slide slide--{{ view.slide.type }} on-{{ view.surface }}" data-slide="{{ view.n }}" aria-label="Slide {{ view.n }} of {{ view.total }}">
<div class="rail" aria-hidden="true"><div class="rail__fill" style="height:{{ view.progress_pct }}%"></div></div>
<div class="body" data-fit="body">
{{ caller() }}
</div>
<footer class="foot" data-fit="footer">
<p class="foot__who">{% if author_in_footer %}<span class="foot__name">{{ view.brand.author_name }}</span>{% endif %}{% if view.brand.disclaimer %}<span class="foot__note">{{ view.brand.disclaimer }}</span>{% endif %}</p>
<p class="foot__num">{{ view.n }} / {{ view.total }}</p>
</footer>
</section>
{%- endmacro %}
